FINMODEL_DB_PASSWORD=demo-database-only
FINMODEL_S3_PASSWORD=demo-storage-only

GIGACHAT_CREDENTIALS=
GIGACHAT_MODEL=GigaChat-3-Ultra
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_BASE_URL=https://api.giga.chat/v1
# Публичный корневой сертификат подключается только к этому приложению.
GIGACHAT_CA_BUNDLE=certs/russian_trusted_root_ca_pem.crt

# Бюджеты одного анализа (необязательные переопределения).
